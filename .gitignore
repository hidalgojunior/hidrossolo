# Arquivos de configuração sensíveis
.env
.env.producao
config.local.php

# Credenciais de deploy (FTP/SFTP)
.ftp-deploy.conf
.deploy-*.conf
*.ftp-credentials

# Logs
*.log
error_log

# Backups
backup_*.php
*backup*

# Arquivos temporários
*.tmp
*.temp

# Diretórios de upload (exceto estrutura)
uploads/*/
!uploads/.gitkeep

# IDE
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Banco de dados
*.sql
!db_structure.sql

# Caches gerados em tempo de execucao (dompdf grava os metadados de fonte
# na primeira vez que um PDF e gerado). O deploy por rsync continua enviando
# os arquivos, pois usa a arvore de trabalho — so nao entram no git.
vendor/dompdf/dompdf/lib/fonts/*.ufm.json